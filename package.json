{
  "name": "smart-campus-lost-found",
  "version": "1.0.0",
  "description": "AI-Powered Smart Campus Lost & Found System using Google Gemini 2.5 Flash Multimodal Matching",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "db:init": "psql $DATABASE_URL -f database/schema.sql",
    "db:seed": "psql $DATABASE_URL -f database/seed.sql",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.24",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3",
    "vercel": "^59.26.0"
  },
  "keywords": [
    "lost-and-found",
    "gemini",
    "ai",
    "multimodal",
    "react",
    "express",
    "postgresql",
    "genai",
    "vercel"
  ],
  "author": "Antigravity Engineering",
  "license": "ISC"
}
